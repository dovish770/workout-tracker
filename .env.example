# Neon Postgres connection string (pooled).
DATABASE_URL=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# This deployment's own origin, e.g. http://localhost:3000 or the Vercel URL
BETTER_AUTH_URL=
# Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web application).
# Authorised redirect URIs must include, for every origin you run on:
#   <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
